{
  "name": "@tridha643/helix-cli",
  "version": "0.2.0",
  "description": "CLI for indexing git repositories into HelixDB and querying the dependency graph",
  "packageManager": "bun@1.3.9",
  "type": "module",
  "bin": {
    "helix": "dist/cli/helix.js"
  },
  "files": [
    "dist/",
    "db/",
    "helix.toml",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "studio": "prisma studio",
    "extract:pdf": "tsx src/extract-pdf-cli.ts",
    "ingest:pdf": "tsx src/ingest-pdf-file.ts",
    "ingest:md": "tsx src/ingest-md-file.ts",
    "index": "tsx src/indexer/indexRepo.ts",
    "test": "node --import tsx --test test/indexer/dagAnalysis.test.ts test/indexer/extractImports.test.ts test/indexer/resolveImport.test.ts test/indexer/walkGitTree.test.ts test/indexer/indexRepo.test.ts",
    "test:daemon": "bun test test/daemon/",
    "test:integration": "tsx src/indexer/verifyIndexer.ts --integration-only",
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/indexer/verifyIndexer.ts",
    "mount": "node --import tsx src/fuse/mount.ts",
    "test:fuse": "bun test test/fuse/",
    "helix": "bun src/cli/helix.ts",
    "test:cli": "bun test test/cli/",
    "build": "bun build src/cli/helix.ts --outdir dist/cli --target bun --packages external && bun build src/daemon/daemon.ts --outdir dist/daemon --target bun --packages external && bun build src/indexer/indexRepo.ts --outdir dist/indexer --target bun --packages external",
    "build:bin": "bun build src/cli/helix.ts --compile --outfile helix",
    "build:bin:linux-x64": "bun build src/cli/helix.ts --compile --target=bun-linux-x64 --outfile helix-linux-x64",
    "build:bin:linux-arm64": "bun build src/cli/helix.ts --compile --target=bun-linux-arm64 --outfile helix-linux-arm64",
    "build:bin:darwin-x64": "bun build src/cli/helix.ts --compile --target=bun-darwin-x64 --outfile helix-darwin-x64",
    "build:bin:darwin-arm64": "bun build src/cli/helix.ts --compile --target=bun-darwin-arm64 --outfile helix-darwin-arm64",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@prisma/client": "5.19.1",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "fuse-native": "^2.2.6",
    "helix-ts": "^1.0.8",
    "pdf-parse": "^1.1.1",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "prisma": "5.19.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
