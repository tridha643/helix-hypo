# Copy to `.env` (never commit `.env`).
OPENAI_API_KEY=
HELIX_OPENAI_API_KEY=

# PostgreSQL — required for Prisma + ingest CLIs.
# Use postgresql:// or postgres:// (not postgresql+psycopg://).
# Example: docker run -d --name helix-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=helix -p 5432:5432 postgres:16
# DATABASE_URL=postgresql://postgres:dev@127.0.0.1:5432/helix

# TS ingest pipeline (Bun):
#   bun install
#   bun run generate
#   bun run migrate
#   bun run extract:pdf -- ./path/to.pdf
#   CORPUS_ID=default bun run ingest:pdf -- ./path/to.pdf
#   CORPUS_ID=default bun run ingest:md -- ./path/to.md
